# ============================================================
# Backend - variables de entorno
#
# Orden de carga (backend/src/config.js):
#   1. .env de la RAIZ del proyecto  -> base
#   2. backend/.env                 -> tiene PRIORIDAD (override)
#
# Si solo configuras el .env raiz, este archivo no es necesario.
# Copia este archivo a backend/.env solo si necesitas valores
# distintos para el backend.
#
# Para una configuracion completa (incluye variables del frontend)
# usa el .env.example de la raiz del proyecto.
# ============================================================

NODE_ENV=development
PORT=3000

# --- Supabase ---
# Obtener en: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://tu-proyecto.supabase.co
# OBLIGATORIA. Service role key (nunca exponer al frontend)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Opcional en el backend (no se usa en src/); el frontend usa su
# propia variable VITE_SUPABASE_ANON_KEY
SUPABASE_ANON_KEY=tu-anon-key

# --- Seguridad ---
# OBLIGATORIA. Generar una cadena larga y aleatoria, ej:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# --- Balanceador de cargas / rate limit ---
MAX_CONCURRENT_REQUESTS=50
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
