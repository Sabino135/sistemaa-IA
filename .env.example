# ============================================================
# Variables de entorno - configurar en Vercel y localmente
# NUNCA subir el archivo .env real al repositorio
# ============================================================

# --- Backend ---
NODE_ENV=development
PORT=3000

# Supabase (backend usa service_role; el frontend solo la anon key)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_ANON_KEY=tu-anon-key

# Seguridad (JWT propio, solo para tokens legacy)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Balanceador de cargas / límites
MAX_CONCURRENT_REQUESTS=50
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Frontend (Vite, solo variables públicas con prefijo VITE_) ---
VITE_API_URL=/api
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
